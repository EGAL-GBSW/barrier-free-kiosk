# 이 파일을 .env.local로 복사해서 사용합니다. 값을 바꾸면 개발 서버를 다시 시작해야 합니다.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_CHECKOUT_MODE=demo
# 두 모드 모두 Web Speech로 텍스트 추출. ai: 팀원 AI 분석, browser: 브라우저 내 규칙 분석.
VITE_VOICE_MODE=browser

# 토스페이먼츠 공개 문서용 TEST 클라이언트 키입니다. 시크릿 키는 프론트에 넣지 않습니다.
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
